<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="เพิ่มโน้ตใหม่ (Add Note)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ช่องกรอกชื่อผู้ใช้ (User) -->
        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ชื่อเจ้าของโน้ต (User Name)"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- ช่องกรอกหัวข้อ (Title) -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="หัวข้อโน้ต (Note Title)"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- ช่องกรอกเนื้อหา (Content / Checklist items) -->
        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="เนื้อหาโน้ต (หากเป็น Checklist ให้คั่นด้วย ,)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <!-- ปุ่มกดสร้าง TextNote -->
        <Button
            android:id="@+id/btnAddTextNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="บันทึกเป็น TextNote"
            android:layout_marginBottom="8dp" />

        <!-- ปุ่มกดสร้าง CheckListNote -->
        <Button
            android:id="@+id/btnAddChecklistNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="บันทึกเป็น CheckListNote"
            android:layout_marginBottom="24dp" />

        <!-- ส่วนแสดงผลข้อมูลโน้ตที่สร้างร่วมกับ User -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ผลลัพธ์จะแสดงที่นี่..."
            android:textSize="14sp"
            android:background="#EFEFEF"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
